# Direct Claude API — script generation
# Set LLM_PROVIDER to anthropic or openrouter; empty chooses Claude when its key is present.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional OpenRouter alternative
OPENROUTER_API_KEY=
# Any OpenRouter model slug; defaults to anthropic/claude-sonnet-4.6
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# ElevenLabs — German voice over
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_LANGUAGE=de
# Optional: refuse any single narration request longer than this many characters (default 3000)
# ELEVENLABS_MAX_CHARS=3000

# HeyGen — talking avatar (audio-driven)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=

# Optional: write finished videos outside the repo (default: ./video)
# VIDEO_OUTPUT_DIR=D:/ad-renders

# Meta Marketing API — read-only ad performance sync (Performance page)
# Connections (one token + its ad accounts per business) are managed in the dashboard: Performance →
# Meta Ads → Manage connections. They are stored in data/agent-queue/agent.sqlite, so nothing else is needed here.
# Optional legacy pair: shows up as a read-only connection named "From .env".
# System-user token with ads_read on the account(s); ids with or without the act_ prefix, comma separated.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
# Optional: name for that connection, Graph API version (default v21.0), which action types count as
# conversions / leads, and META_ENV_CONNECTION_ENABLED=0 to pause it without deleting the token.
# META_CONNECTION_LABEL=Main Business Manager
# META_API_VERSION=v21.0
# META_CONVERSION_ACTIONS=purchase,omni_purchase,offsite_conversion.fb_pixel_purchase
# META_LEAD_ACTIONS=lead,onsite_conversion.lead_grouped
# META_ENV_CONNECTION_ENABLED=1

# Optional: local transcription for external / competitor creatives on the Performance page
# WHISPER_CMD=whisper {file} --language de --model small --output_format txt --output_dir {dir}

# Google Ads API — read-only ad performance sync (Performance page)
# Developer token from the API Center, an OAuth client (Desktop app) and a refresh token with the adwords scope.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Customer ids (digits or 123-456-7890), comma separated; the manager account id if accessed through an MCC.
GOOGLE_ADS_CUSTOMER_IDS=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v19
